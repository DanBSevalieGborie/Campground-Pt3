<?xml version="1.0" encoding="utf-8"?>
<!-- The park detail screen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ParkDetailActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.ParksAndCampgrounds.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:theme="@style/ThemeOverlay.ParksAndCampgrounds.Toolbar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/gallery"
                layout="@layout/view_photo_gallery" />

            <LinearLayout
                android:id="@+id/detail_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="32dp">

                <TextView
                    android:id="@+id/park_designation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.ParksAndCampgrounds.Overline"
                    tools:text="National Park" />

                <TextView
                    android:id="@+id/park_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    tools:text="Acadia National Park" />

                <TextView
                    android:id="@+id/park_states"
                    style="@style/Widget.ParksAndCampgrounds.LocationText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    tools:text="Maine" />

                <!-- Open in Google Maps / official NPS website -->
                <LinearLayout
                    android:id="@+id/action_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/directions_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="@string/directions"
                        app:icon="@drawable/ic_directions" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/website_button"
                        style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/website"
                        app:icon="@drawable/ic_open_in_new" />

                </LinearLayout>

                <!-- Entrance fee -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.ParksAndCampgrounds.InfoCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/entrance_fee"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:id="@+id/fee_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:textStyle="bold"
                            tools:text="$35.00" />

                        <TextView
                            android:id="@+id/fee_detail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            tools:text="Private Vehicle" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/description_section"
                    style="@style/Widget.ParksAndCampgrounds.Section">

                    <TextView
                        style="@style/Widget.ParksAndCampgrounds.SectionTitle"
                        android:text="@string/about" />

                    <TextView
                        android:id="@+id/park_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.ParksAndCampgrounds.Body"
                        tools:text="Acadia National Park protects the natural beauty of the highest rocky headlands along the Atlantic coastline of the United States." />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/activities_section"
                    style="@style/Widget.ParksAndCampgrounds.Section">

                    <TextView
                        style="@style/Widget.ParksAndCampgrounds.SectionTitle"
                        android:text="@string/things_to_do" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/activities_chips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingVertical="4dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/weather_section"
                    style="@style/Widget.ParksAndCampgrounds.Section">

                    <TextView
                        style="@style/Widget.ParksAndCampgrounds.SectionTitle"
                        android:text="@string/weather" />

                    <TextView
                        android:id="@+id/park_weather"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.ParksAndCampgrounds.Body"
                        tools:text="Located on Mount Desert Island in Maine, Acadia experiences all four seasons." />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/getting_there_section"
                    style="@style/Widget.ParksAndCampgrounds.Section">

                    <TextView
                        style="@style/Widget.ParksAndCampgrounds.SectionTitle"
                        android:text="@string/getting_there" />

                    <TextView
                        android:id="@+id/park_getting_there"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.ParksAndCampgrounds.Body"
                        tools:text="From Boston take I-95 north to Augusta, Maine, then Route 3 east to Ellsworth." />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
